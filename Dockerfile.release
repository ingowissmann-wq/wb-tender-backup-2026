ARG RUNTIME_IMAGE=node@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
FROM ${RUNTIME_IMAGE}

ENV EXTERNAL_SUBMISSION_ENABLED=false \
    WB_TENDER_ALLOW_EXTERNAL_SUBMISSION=false \
    WB_TENDER_SAAS_LEGACY_API_ENABLED=false \
    CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && node --input-type=module -e 'import {createHash} from "node:crypto"; import {writeFileSync} from "node:fs"; const r=await fetch("https://www.postgresql.org/media/keys/ACCC4CF8.asc"); if(!r.ok)throw Error("pgdg_key_download_failed"); const key=Buffer.from(await r.arrayBuffer()); if(createHash("sha256").update(key).digest("hex")!=="0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76")throw Error("pgdg_key_checksum_mismatch"); writeFileSync("/usr/share/keyrings/postgresql.asc",key);' \
 && printf 'deb [signed-by=/usr/share/keyrings/postgresql.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main\n' > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16=16.15-1.pgdg12+2 postgresql-client-common=293.pgdg12+1 libpq5=18.6-1.pgdg12+2 chromium=152.0.7977.82-1~deb12u1 chromium-common=152.0.7977.82-1~deb12u1 \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/cache/debconf/* /var/cache/ldconfig/* \
 && rm -f /var/log/alternatives.log /var/log/dpkg.log /var/log/apt/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --audit=false --fund=false \
 && rm -rf /root/.npm /tmp/*
COPY --chown=root:root . /app/
COPY --chown=root:root deployment/wb-tender-ingestion-entrypoint /usr/local/bin/wb-tender-ingestion-entrypoint
RUN chmod 0555 /usr/local/bin/wb-tender-ingestion-entrypoint \
 && node scripts/verify-browser-runtime.mjs
ARG RELEASE_VERSION
ARG SOURCE_FINGERPRINT
ARG SOURCE_TREE
LABEL org.opencontainers.image.title="WB Tender release" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_FINGERPRINT}" \
      org.opencontainers.image.source-tree="${SOURCE_TREE}"
