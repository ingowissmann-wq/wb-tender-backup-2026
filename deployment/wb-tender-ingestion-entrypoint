#!/bin/sh
set -eu

[ "${NODE_ENV:-}" = production ] || { echo 'FATAL: NODE_ENV=production is required' >&2; exit 78; }
[ "${EXTERNAL_SUBMISSION_ENABLED:-false}" = false ] || { echo 'FATAL: external submission must remain disabled' >&2; exit 78; }
[ "${WB_TENDER_ALLOW_EXTERNAL_SUBMISSION:-false}" = false ] || { echo 'FATAL: external submission override must remain disabled' >&2; exit 78; }
[ -n "${DATABASE_URL_FILE:-}" ] && [ -r "$DATABASE_URL_FILE" ] || { echo 'FATAL: DATABASE_URL_FILE is required' >&2; exit 78; }
exec node /app/platform/source-ingestion.mjs
