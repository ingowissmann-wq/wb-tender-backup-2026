ARG ADMIN_TENDER_BASE=wb-tender:global-selected-lot-region-candidate.17
FROM ${ADMIN_TENDER_BASE}

ARG SOURCE_FINGERPRINT
ARG RELEASE_VERSION
ARG ADMIN_TENDER_BASE_ID

USER root
WORKDIR /app

RUN npm install \
      --omit=dev \
      --no-audit \
      --no-fund \
      --package-lock=false \
      '@fastify/multipart@9.2.1' \
      '@fastify/static@8.2.0' \
      'archiver@7.0.1' \
      'ioredis@5.6.1' \
      'sanitize-html@2.17.0' \
      'zod@3.25.76' \
      'argon2@0.41.1' \
 && npm cache clean --force

RUN install -d -m 0755 \
      /app/apps/api/dist \
      /app/apps/admin/dist

COPY --chown=root:root integrations/wb-admin-portal/production-dist-baseline/api/ /app/apps/api/dist/
COPY --chown=root:root integrations/wb-admin-portal/production-dist-baseline/admin/ /app/apps/admin/dist/
COPY --chown=root:root integrations/wb-admin-portal/candidate/commercial-tenancy.js /app/apps/api/dist/commercial-tenancy.js
COPY --chown=root:root integrations/wb-admin-portal/candidate/module-navigation.js /app/apps/admin/dist/module-navigation.js
COPY --chown=root:root integrations/wb-admin-portal/candidate/db.js /tmp/admin-commercial-tenancy-db.js
COPY --chown=root:root integrations/wb-admin-portal/candidate/admin-login-mfa-enrollment-patch.mjs /tmp/admin-login-mfa-enrollment-patch.mjs
COPY --chown=root:root deployment/admin-commercial-tenancy-patch.mjs /tmp/admin-commercial-tenancy-patch.mjs
COPY --chown=root:root --chmod=0555 deployment/wb-admin-runtime-entrypoint /usr/local/bin/wb-admin-runtime-entrypoint
COPY --chown=root:root deployment/admin-runtime-dependency-audit.mjs /tmp/admin-runtime-dependency-audit.mjs

RUN node /tmp/admin-login-mfa-enrollment-patch.mjs /app \
 && node /tmp/admin-commercial-tenancy-patch.mjs /app /tmp/admin-commercial-tenancy-db.js \
 && node --check /app/apps/api/dist/server.js \
 && node --check /app/apps/api/dist/db.js \
 && node /tmp/admin-runtime-dependency-audit.mjs \
 && rm -f \
      /tmp/admin-login-mfa-enrollment-patch.mjs \
      /tmp/admin-commercial-tenancy-patch.mjs \
      /tmp/admin-commercial-tenancy-db.js \
      /tmp/admin-runtime-dependency-audit.mjs \
 && chown -R root:root /app/apps \
 && chmod -R a=rX,u+w /app/apps

ENV HOST=0.0.0.0 \
    PORT=3400 \
    NODE_ENV=production \
    PUBLIC_ORIGIN=https://www.enwi.online \
    CAREER_DATABASE_PATH=/data/career.db \
    PRIVATE_FILE_ROOT=/data/private \
    CAREER_UPLOAD_ROOT=/data/career-uploads \
    REDIS_HOST=admin-redis \
    DATABASE_URL_FILE=/run/secrets/database_url \
    SESSION_PEPPER_FILE=/run/secrets/session_pepper \
    FIELD_ENCRYPTION_KEY_FILE=/run/secrets/iam_field_key \
    BOOTSTRAP_ADMIN_EMAIL_FILE=/run/secrets/owner_email \
    BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/admin_bootstrap_password \
    REDIS_PASSWORD_FILE=/run/secrets/admin_redis_password \
    WB_ADMIN_SAAS_ENABLED=false \
    WB_ADMIN_TENANCY_ENFORCED=false \
    WB_ADMIN_TENANT_FILE_STORAGE_ENABLED=false \
    EXTERNAL_SUBMISSION_ENABLED=false \
    WB_TENDER_ALLOW_EXTERNAL_SUBMISSION=false

LABEL org.opencontainers.image.title="WB Admin portal recovery candidate" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_FINGERPRINT}" \
      org.opencontainers.image.base.digest="${ADMIN_TENDER_BASE_ID}" \
      wb.release.scope="internal-admin-recovery-candidate" \
      wb.external.submission="disabled" \
      wb.admin.saas.default="disabled"

USER pwuser
EXPOSE 3400

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=4 \
  CMD node -e 'fetch("http://127.0.0.1:3400/api/healthz").then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))'

ENTRYPOINT ["/usr/local/bin/wb-admin-runtime-entrypoint"]
