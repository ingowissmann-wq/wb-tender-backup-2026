[Unit]
Description=Encrypted complete WB Tender backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/srv/wb-green/wb-tender-backup-v2/backup.env
ExecStart=/srv/wb-green/wb-tender-backup-v2/tender-encrypted-backup.sh
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
