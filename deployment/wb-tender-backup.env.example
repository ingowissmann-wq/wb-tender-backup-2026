# Non-secret systemd environment for the post-cutover production backup.
# Initial restore-clone proof overrides this with the exact preserved clone.
DATABASE_CONTAINER=wb-tender-production-db
PRODUCTION_ROOT=/srv/wb-tender-production
SOURCE_REPOSITORY=/srv/wb-tender-recovery/canonical-source/f862ceb69ee2ee73d3ba3af82c9bad5b7bbf73fc
BACKUP_ROOT=/srv/wb-green/backups/wb-tender/daily
BACKUP_KEY_ROOT=/srv/wb-green/backup-keys/wb-tender/daily
RETENTION_DAYS=14
DISABLE_RETENTION=false
POSTGRES_IMAGE=postgres:16-alpine
PG_DUMP_COMPRESS=1
