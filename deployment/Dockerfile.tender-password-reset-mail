ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY integrations/wb-admin-portal/candidate/tender-password-reset-mail-patch.mjs /tmp/tender-password-reset-mail-patch.mjs
COPY integrations/wb-admin-portal/candidate/tender-password-reset-secure-start.mjs /app/tender-password-reset-secure-start.mjs
RUN node /tmp/tender-password-reset-mail-patch.mjs /app/apps/api/dist/server.js \
 && node --check /app/apps/api/dist/server.js \
 && node --check /app/tender-password-reset-secure-start.mjs \
 && rm /tmp/tender-password-reset-mail-patch.mjs
USER root
ENTRYPOINT ["node", "/app/tender-password-reset-secure-start.mjs"]
CMD []
